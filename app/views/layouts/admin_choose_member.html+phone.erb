<%= render layout: 'layouts/phone_head' do %>
  <div class="as-bar">
    <button id="history-button" data-controller="history" data-action="history#back" class="left">
      <%= svg_tag 'angle-left', kind: 'regular', class: 'icon is-small text-link' %>
    </button>
    <div class="bar-title"></div>
    <i class="right"></i>
  </div>
  <main id="weui-tab__panel">
    <%= yield %>
  </main>
  <div class="buttons as-bottom">
    <%= link_to({ controller: 'org/board/organs', action: 'new' }, class: 'button is-rounded is-fullwidth is-primary') do %>
      <%= svg_tag 'plus' %>
      <span><%= t('org.board.organs.new.title') %></span>
    <% end %>
  </div>
<% end %>

<div id="tr_<%= model.organ_id %>" class="media">
  <div class="media-content">
    <p class="has-block-left">
      <span><%= model.organ.name %></span>
      <% if model.owned %>
        <span class="tag is-success"><%= model.owned_i18n %></span>
      <% end %>
      <% model.cache.roles_arr.each do |role_str| %>
        <span class="tag"><%= role_str %></span>
      <% end %>
    </p>
  </div>
  <div class="media-right">
    <% if model.organ.provider %>
      <span>已绑定</span>
      <span class="tag"><%= model.organ.provider.name %></span>
    <% else %>
      <%= button_to({ controller: 'members', action: 'bind', id: model.id, **params.permit(:provider_token).permit! }, class: 'button is-small is-link') do %>
        <%= svg_tag 'handshake' %>
        <span><%= t('.members.bind.title') %></span>
      <% end %>
    <% end %>
  </div>
</div>

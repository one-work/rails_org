<div class="media">
  <div class="media-content">
    <p class="has-block-left">
      <span><%= model.organ.name %></span>
      <% if model.owned %>
        <span class="tag is-success"><%= model.owned_i18n %></span>
      <% end %>
      <% model.cache.roles_arr.each do |role_str| %>
        <span class="tag"><%= role_str %></span>
      <% end %>
    </p>
  </div>
  <div class="media-right">
    <% if model.organ.provider_id == current_organ.id %>
      <span>已绑定</span>
    <% else %>
      <%= button_to({ action: 'bind', id: model.organ_id }, method: :patch, class: 'button is-small is-link') do %>
        <%= svg_tag 'handshake' %>
        <span><%= t('.bind.title') %></span>
      <% end %>
    <% end %>
  </div>
</div>

<div class="card as-transparent">
  <div class="card-header">
    <span class="size-7 text-grey has-border-left-primary">我的门店</span>
  </div>
  <div class="card-content fixed-grid has-2-cols">
    <div class="grid">
      <%=
        link_to(
          { controller: 'org/board/organs', action: 'owned' },
          class: 'cell has-column-centered'
        ) do
      %>
        <strong class="size-5"><%= current_user.members.owned.count %></strong>
        <p class="size-7 text-grey">我创建的</p>
      <% end %>
      <%=
        link_to(
          { controller: 'org/board/organs', action: 'joined' },
          class: 'cell has-column-centered'
        ) do
      %>
        <strong class="size-5"><%= current_user.members.joined.count %></strong>
        <p class="size-7 text-grey">我加入的</p>
      <% end %>
    </div>
  </div>
</div>

<div class="box p-0">
  <%= link_to({ controller: 'home', action: 'index' }, class: 'media') do %>
    <div class="media-content">
      <%= svg_tag 'crown' %>
      <span>会员</span>
    </div>
    <div class="media-right">
      <%= svg_tag 'chevron-right' %>
    </div>
  <% end %>
</div>

<%= render 'power_login' %>

<%=
  tr_tag(
    model,
    {
      href: url_for(controller: 'organ_domains', organ_id: model.id),
      icon: 'mobile',
      title: t('.organ_domains.index.title')
    },
    {
      href: url_for(action: 'mock', id: model.id),
      icon: 'hand-point-right',
      title: t('.mock.title'),
      target: '_blank'
    },
    {
      href: url_for(controller: '/home', host: model.host, auth_token: Current.session.once_token),
      icon: 'eye',
      title: '预览',
      target: '_blank'
    }
  ) { yield }
%>

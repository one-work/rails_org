<div>
  <dt><%= Org::Organ.human_attribute_name(:name) %></dt>
  <dd><%= @organ.name %></dd>
</div>
<div>
  <dt><%= Org::Organ.human_attribute_name(:logo) %></dt>
  <dd><%= image_tag @organ.logo.variant(resize_to_limit: [32, 32]), class: 'image is-32x32' if @organ.logo.attached? %></dd>
</div>
<div>
  <dt><%= Org::Organ.human_attribute_name(:name_short) %></dt>
  <dd><%= @organ.name_short %></dd>
</div>
<div>
  <dt><%= Org::Organ.human_attribute_name(:area_id) %></dt>
  <dd><%= @organ.area&.full_name %></dd>
</div>
<div>
  <dt><%= Org::Organ.human_attribute_name(:license) %></dt>
  <dd><%= @organ.license %></dd>
</div>
<div>
  <dt><%= Org::Organ.human_attribute_name(:geo) %></dt>
  <dd><%= @organ.geo %></dd>
</div>
<div>
  <dt><%= Org::Organ.human_attribute_name(:address) %></dt>
  <dd><%= @organ.address %></dd>
</div>
<div>
  <dt><%= Org::Organ.human_attribute_name(:dispatches) %></dt>
  <dd>
    <div class="tags">
    <%= @organ.dispatches.each do |dispatch| %>
      <span class="tag"><%= Trade::Item.enum_i18n(:dispatch, dispatch) %></span>
    <% end %>
    </div>
  </dd>
</div>
<div>
  <dt><%= Org::Organ.human_attribute_name(:dispatche) %></dt>
  <dd><%= @organ.dispatch_i18n %></dd>
</div>
<div>
  <dt></dt>
  <dd>
    <%= image_tag @scene.qrcode_data_url, class: 'image' if @scene %>
  </dd>
</div>

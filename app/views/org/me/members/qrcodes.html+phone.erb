<div class="box">
  <p class="text-centered">
    <strong><%= @member.organ.name %></strong>
    <span><%= @member.name %></span>
  </p>
  <figure class="image">
    <%= image_tag @scene.qrcode_data_url if @scene %>
  </figure>
</div>

<div class="card as-transparent">
  <div class="card-header">
    <span class="size-7 text-grey has-border-left-primary">邀请记录</span>
  </div>
  <div class="card-content">
    <%= render partial: 'request', collection: @requests, as: :request %>
  </div>
</div>

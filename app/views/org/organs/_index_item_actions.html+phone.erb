<div id="tr_<%= model.id %>" class="as-boxed">
  <div class="media p-3 mb-0">
    <div class="media-left align-self-auto">
      <% if model.logo.attached? %>
        <%= image_tag model.logo.variant(resize_to_limit: [64, 64]), class: 'image is-64x64' %>
      <% else %>
        <%= image_tag 'logo_organ.png', class: 'image is-64x64' %>
      <% end %>
    </div>
    <%=
      link_to(
        {
          controller: 'factory/productions',
          host: model.host,
          **{ auth_token: Current.session&.once_token, from_provider: current_organ&.id, dispatch: model.dispatch }.compact
        },
        class: 'media-content'
      ) do
    %>
      <%= yield %>
    <% end %>
    <div class="media-right">
      <%=
        link_to(
          {
            controller: 'factory/productions',
            host: model.host,
            **{ auth_token: Current.session&.once_token, from_provider: current_organ&.id, dispatch: model.dispatch }.compact
          },
          class: 'button is-primary'
        ) do
      %>
        <span>去下单</span>
      <% end %>
    </div>
  </div>
  <div class="cards is-4 background-light">
    <%= render partial: 'card', collection: model.top_productions, as: :model %>
  </div>
</div>

<div>
  <strong><%= model.name %></strong>
  <% if model.start_at.present? && model.finish_at.present? %>
    <div class="tag">
      <span><%= model.start_at.to_fs(:time) %></span>
      <span>~</span>
      <span><%= model.finish_at.to_fs(:time) %></span>
    </div>
  <% end %>
  <% if model.printer_online? %>
    <span class="tag">
      <%= svg_tag 'print', class: 'icon is-small text-primary' %>
      <span>在线</span>
    </span>
  <% end %>
</div>
<% if model.address.present? %>
  <p class="size-7">
    <%= svg_tag 'location-dot', class: 'icon is-small text-grey' %>
    <span><%= model.address_short.presence || model.address %></span>
  </p>
  <p>
  <% if model.distance.presence %>
    <span><%= model.distance %></span>
  <% end %>
  </p>
<% end %>

<div class="as-bar">
  <i class="left"></i>
  <div></div>
  <%= link_to({ controller: 'ship/board/addresses' }, class: 'right') do %>
    <%= svg_tag 'arrow-right-arrow-left' %>
    <% if current_user&.address_principal %>
      <span class="size-7 text-grey"><%= current_user.address_principal.detail %></span>
    <% else %>
      <span class="size-7 text-grey"><%= current_user&.address_simple %></span>
    <% end %>
  <% end %>
</div>

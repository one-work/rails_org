<div class="as-bar justify-content-space-between">
  <i></i>
  <div class="pr-3">
    <%= link_to({ controller: 'ship/board/addresses' }) do %>
      <%= svg_tag 'arrow-right-arrow-left' %>
      <% if current_user&.address_principal %>
        <span class="size-7"><%= current_user.address_principal.detail %></span>
      <% else %>
        <span class="size-7"><%= current_user&.address_simple %></span>
      <% end %>
    <% end %>
  </div>
</div>
